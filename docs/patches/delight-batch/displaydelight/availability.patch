+    /** Resolve a display directly from registries, including before server maps exist. */
+    public static Item sourceFood(Item display) {
+        if (!(display instanceof FoodBlockItem)) return Items.AIR;
+        String path = BuiltInRegistries.ITEM.getKey(display).getPath();
+        String namespace = getNamespace(path);
+        String food = removeFirstPrefix(path, COMPAT_NAMESPACES.keySet());
+        food = removeFirstPrefix(food, Arrays.asList(TypePrefixes));
+        if (namespace.isEmpty()) namespace = VanilaFoods.contains(food) ? MINECRAFT : FARMERSDELIGHT;
+        if (!namespace.equals(MINECRAFT) && !ModList.get().isLoaded(namespace)) return Items.AIR;
+        // Preserve the upstream Festive Delight spelling alias.
+        if (namespace.equals("festive_delight") && food.equals("festive_chicken")) food = "festive_chiken";
+        return BuiltInRegistries.ITEM.getValue(Identifier.fromNamespaceAndPath(namespace, food));
+    }
+
+    private static TagKey<Item> category(Item display) {
+        String path = removeFirstPrefix(BuiltInRegistries.ITEM.getKey(display).getPath(), COMPAT_NAMESPACES.keySet());
+        if (path.startsWith("small_plated_")) return DisplayTags.SMALL_PLATE_DISPLAYABLE;
+        if (path.startsWith("plated_")) return DisplayTags.PLATE_DISPLAYABLE;
+        return DisplayTags.DISPLAYABLE;
+    }
+
+    public static boolean isAvailable(Item display) {
+        if (!(display instanceof FoodBlockItem)) return true; // Empty plates have no source meal.
+        Item food = sourceFood(display);
+        if (food == Items.AIR || !isItemInTag(food, category(display))) return false;
+        return !(DisplayConfig.DISABLE_VANILLA_FOODS.get()
+                && BuiltInRegistries.ITEM.getKey(food).getNamespace().equals(MINECRAFT)
+                && category(display).equals(DisplayTags.DISPLAYABLE));
+    }
+
+    public static void initialize(Iterable<Item> allItems) {
+        blockMap.clear(); itemMap.clear();
+        plateBlockMap.clear(); plateItemMap.clear();
+        smallplateBlockMap.clear(); smallplateItemMap.clear();
+        TRADEABLE_FOODS.clear(); TRADEABLE_DRINKS.clear();
+        TRADEABLE_PLATES.clear(); TRADEABLE_SMALL_PLATES.clear();
+        for (Item display : allItems) {
+            if (!(display instanceof FoodBlockItem blockItem)) continue;
+            if (!isAvailable(display)) continue;
+            Item food = sourceFood(display);
+            var type = category(display);
+            if (type.equals(DisplayTags.SMALL_PLATE_DISPLAYABLE)) addSmallPlateToMap(food, blockItem.getBlock());
+            else addToMap(food, blockItem.getBlock(), type.equals(DisplayTags.PLATE_DISPLAYABLE));
+            if (NO_WANDERING_TRADER.contains(BuiltInRegistries.ITEM.getKey(food).getNamespace())) continue;
+            if (blockItem.isDrink) TRADEABLE_DRINKS.add(display);
+            else if (type.equals(DisplayTags.SMALL_PLATE_DISPLAYABLE)) TRADEABLE_SMALL_PLATES.add(display);
+            else if (type.equals(DisplayTags.PLATE_DISPLAYABLE)) TRADEABLE_PLATES.add(display);
+            else TRADEABLE_FOODS.add(display);
+        }
     }
 }
