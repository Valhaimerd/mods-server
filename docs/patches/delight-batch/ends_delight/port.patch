diff --git a/src/probe/java/EndsProbe.java b/src/probe/java/EndsProbe.java
new file mode 100644
index 0000000..7f41b07
--- /dev/null
+++ b/src/probe/java/EndsProbe.java
@@ -0,0 +1,53 @@
+package cn.foggyhillside.ends_probe;
+import cn.foggyhillside.ends_delight.registry.*;
+import cn.foggyhillside.ends_delight.block.entity.EndStoveBlockEntity;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.entity.item.ItemEntity;
+import net.minecraft.world.phys.AABB;
+import net.neoforged.fml.common.Mod;
+import net.neoforged.neoforge.common.NeoForge;
+import net.neoforged.neoforge.event.server.ServerStartedEvent;
+import vectorwing.farmersdelight.common.block.AbstractStoveBlock;
+import vectorwing.farmersdelight.common.block.entity.AbstractStoveBlockEntity;
+@Mod("ends_probe")
+public class EndsProbe {
+ public EndsProbe() { NeoForge.EVENT_BUS.addListener(this::run); }
+ static void check(boolean result,String message) { if(!result)throw new AssertionError(message); System.out.println("ENDS_CHECK PASS "+message); }
+ void run(ServerStartedEvent event) {
+  var server=event.getServer();
+  try {
+   check(BuiltInRegistries.ITEM.keySet().stream().filter(x->x.getNamespace().equals("ends_delight")).count()==63,"63 preserved item IDs");
+   check(BuiltInRegistries.BLOCK.keySet().stream().filter(x->x.getNamespace().equals("ends_delight")).count()==8,"8 preserved block IDs");
+   long recipes=server.getRecipeManager().getRecipes().stream().filter(x->x.id().identifier().getNamespace().equals("ends_delight")).count();
+   check(recipes==75,"75 decoded native recipes got="+recipes);
+   var level=server.overworld(); var pos=new BlockPos(32,80,32); level.getChunkAt(pos); level.setBlockAndUpdate(pos,net.minecraft.world.level.block.Blocks.AIR.defaultBlockState()); level.setBlockAndUpdate(pos.above(),net.minecraft.world.level.block.Blocks.AIR.defaultBlockState());
+   var state=ModBlocks.END_STOVE.get().defaultBlockState().setValue(AbstractStoveBlock.LIT,true); level.setBlockAndUpdate(pos,state);
+   var stove=(EndStoveBlockEntity)level.getBlockEntity(pos); stove.clearContent();
+   level.getEntitiesOfClass(ItemEntity.class,new AABB(pos).inflate(4)).forEach(ItemEntity::discard); check(stove!=null && stove.getItems().getSlots()==6,"six-slot native stove entity");
+   var raw=new ItemStack(ModItems.RAW_ENDERMITE_MEAT.get()); var recipe=stove.getCookingRecipe(raw); check(recipe.isPresent(),"native campfire recipe lookup");
+   for(int i=0;i<6;i++)check(stove.placeFood(null,raw.copy(),recipe.orElseThrow()),"native stove insertion slot="+i);
+   check(stove.isFull(),"stove full after six insertions");
+   check(stove.getUpdateTag(level.registryAccess()).contains("Inventory"),"client update tag includes stove inventory");
+   var packet = stove.getUpdatePacket();
+   check(packet != null && packet.getTag().contains("Inventory") && packet.getTag().contains("CookingTotalTimes"), "native update packet includes inventory and cooking timers");
+   var mirror = new EndStoveBlockEntity(pos,state);
+   mirror.loadCustomOnly(net.minecraft.world.level.storage.TagValueInput.create(net.minecraft.util.ProblemReporter.DISCARDING,level.registryAccess(),packet.getTag()));
+   check(mirror.isFull(),"six-slot inventory survives native packet NBT round trip");
+   for(int i=0;i<610;i++) AbstractStoveBlockEntity.serverTick(level,pos,state,stove);
+   check(stove.isEmpty(),"all six slots finish native cooking");
+   int output=level.getEntitiesOfClass(ItemEntity.class,new AABB(pos).inflate(4)).stream().filter(x->x.getItem().is(ModItems.DRIED_ENDERMITE_MEAT.get())).mapToInt(x->x.getItem().getCount()).sum();
+   check(output==6,"six real dried endermite outputs got="+output);
+   var player=net.neoforged.neoforge.common.util.FakePlayerFactory.getMinecraft(level);
+   player.getFoodData().setFoodLevel(10);
+   var stew=new ItemStack(ModItems.SHULKER_SOUP.get()); var bowl=stew.finishUsingItem(level,player);
+   check(bowl.is(net.minecraft.world.item.Items.BOWL),"soup consumption returns original bowl");
+   check(player.hasEffect(net.minecraft.world.effect.MobEffects.LEVITATION),"original soup levitation effect applies");
+   System.out.println("ENDS_CHECK ALL PASS");
+  }catch(Throwable t){t.printStackTrace();System.out.println("ENDS_CHECK FAILED "+t);}
+  finally{server.halt(false);}
+ }
+}
+
+
