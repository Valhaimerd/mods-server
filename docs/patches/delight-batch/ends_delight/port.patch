+version = '2.6.1+neoforge.26.2-port1'
+group = 'cn.foggyhillside.ends_delight'
+base { archivesName = 'ends_delight' }
+java.toolchain.languageVersion = JavaLanguageVersion.of(25)
+neoForge {
+ version = '26.2.0.90'
+ runs { server { server(); programArgument '--nogui' }; client { client() } }
+ mods { ends_delight { sourceSet sourceSets.main } }
+}
+dependencies { implementation files('../../../../../mods/FarmersDelight-26.2-1.3.3-fix5.jar') }
+tasks.withType(JavaCompile).configureEach { options.encoding = 'UTF-8'; options.compilerArgs += ['-Xmaxerrs', '300'] }
+sourceSets.main.resources.srcDir 'src/generated/resources'
+processResources {
+ filesMatching('META-INF/neoforge.mods.toml') { expand(project.properties) }
+ exclude 'pack.mcmeta'
+}
+
+jar { from('LICENSE') }
+if (providers.gradleProperty('probe').isPresent()) {
+ sourceSets { probe { compileClasspath += sourceSets.main.output + sourceSets.main.compileClasspath; runtimeClasspath += output + compileClasspath } }
+ neoForge.mods { ends_probe { sourceSet sourceSets.probe } }
 }
