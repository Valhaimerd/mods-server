diff --git a/verify_resources.py b/verify_resources.py
new file mode 100644
index 0000000..aa3a9d0
--- /dev/null
+++ b/verify_resources.py
@@ -0,0 +1,60 @@
+from pathlib import Path
+import json, subprocess, zipfile
+p=Path(__file__).parent
+roots=[p/'src/main/resources',p/'src/generated/resources']
+fail=[]
+recipes=[]
+for root in roots:
+ for f in root.rglob('*.json'):
+  raw=f.read_bytes(); d=json.loads(raw.decode('utf-16' if raw.startswith(b'\xff\xfe') else 'utf-8-sig'))
+  rel=f.relative_to(root).as_posix()
+  if rel.startswith('data/'):
+   if any(x in rel for x in ['/advancements/','/loot_tables/','/tags/items/','/tags/blocks/']): fail.append(rel+': legacy resource directory')
+   if '/recipe/' in rel:
+    recipes.append(rel)
+    def check(x):
+     if isinstance(x,dict):
+      if set(x) in ({'item'},{'tag'}): fail.append(rel+': legacy ingredient '+str(x))
+      for k,v in x.items():
+       if k not in ['result','container']: check(v)
+     elif isinstance(x,list):
+      for v in x: check(v)
+    check(d)
+assert len(recipes)==18, len(recipes)
+models=list((p/'src/generated/resources/assets/large_meals/models/item').glob('*.json'))
+for f in models:
+ assert (p/'src/generated/resources/assets/large_meals/items'/f.name).exists(),f'No item definition: {f.name}'
+assert not fail,'\n'.join(fail)
+print(f'PASS: {len(recipes)} modern recipes, {len(models)} item definitions, modern data directories')
+
+# Compare each recipe with the pinned source after only the native ingredient migration.
+def native(x):
+ if isinstance(x,list): return [native(v) for v in x]
+ if isinstance(x,dict):
+  if set(x)=={'tag'}: return '#'+x['tag']
+  if set(x)=={'item'} and isinstance(x['item'],str): return x['item']
+  return {k:v if k in ['result','container'] else native(v) for k,v in x.items()}
+ return x
+for f in (p/'src/generated/resources/data/large_meals/recipe').rglob('*.json'):
+ rel=f.relative_to(p).as_posix()
+ original=json.loads(subprocess.check_output(['git','-C',str(p),'show','HEAD:'+rel]))
+ assert json.loads(f.read_text())==native(original), rel+': gameplay recipe changed'
+assert not (p/'src/generated/resources/data/neoforge/loot_modifiers/global_loot_modifiers.json').exists()
+for f in (p/'src/generated/resources/data/large_meals/loot_modifiers').glob('*.json'):
+ d=json.loads(f.read_text())
+ assert any(c.get('predicate',{}).get('minecraft:entity_type')=='minecraft:sheep' for c in d['conditions'])
+print('PASS: all18 recipe payloads preserve pinned upstream ingredients/counts/results/times/containers; native sheep loot predicates')
+
+# Fail on unbound face references or absent dependency textures before launching.
+fd=zipfile.ZipFile(p/'../../../../../mods/FarmersDelight-26.2-1.3.3-fix5.jar')
+for root in roots:
+ for f in root.glob('assets/large_meals/models/**/*.json'):
+  d=json.loads(f.read_text());textures=d.get('textures',{})
+  for texture in textures.values():
+   if texture.startswith('farmersdelight:'):
+    assert 'assets/farmersdelight/textures/'+texture.split(':',1)[1]+'.png' in fd.namelist(),(f,texture)
+  for element in d.get('elements',[]):
+   for face in element.get('faces',{}).values():
+    texture=face.get('texture','')
+    assert not texture.startswith('#') or texture[1:] in textures,(f,texture)
+print('PASS: model face references bound; all Farmer Delight dependency textures exist')
