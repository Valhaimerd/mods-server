diff --git a/regression/cz/krelox/large_meals/probe/LargeMealsProbe.java b/regression/cz/krelox/large_meals/probe/LargeMealsProbe.java
new file mode 100644
index 0000000..74ad0ec
--- /dev/null
+++ b/regression/cz/krelox/large_meals/probe/LargeMealsProbe.java
@@ -0,0 +1,85 @@
+package cz.krelox.large_meals.probe;
+import cz.krelox.large_meals.item.LMItems;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.InteractionHand;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.item.consume_effects.ApplyStatusEffectsConsumeEffect;
+import net.minecraft.world.level.GameType;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.Vec3;
+import net.neoforged.bus.api.SubscribeEvent;
+import net.neoforged.fml.common.EventBusSubscriber;
+import net.neoforged.neoforge.common.util.FakePlayerFactory;
+import net.neoforged.neoforge.event.server.ServerStartedEvent;
+import vectorwing.farmersdelight.common.block.FeastBlock;
+@EventBusSubscriber(modid="large_meals")
+public class LargeMealsProbe {
+ static void check(String name, boolean ok) { if(!ok) throw new AssertionError(name); System.out.println("LM_PROBE PASS "+name); }
+ @SubscribeEvent public static void start(ServerStartedEvent event) {
+  var server=event.getServer();
+  try {
+   var recipes=server.getRecipeManager().getRecipes().stream().filter(r->r.id().identifier().getNamespace().equals("large_meals")).toList();
+   check("all_18_recipes_decode",recipes.size()==18);
+   for(var r: recipes) { check("ingredients_"+r.id().identifier(),r.value().placementInfo().ingredients().stream().noneMatch(i->i.isEmpty())); }
+   check("all_18_items",LMItems.ITEMS.getEntries().size()==18);
+   var world=server.overworld(); var player=FakePlayerFactory.getMinecraft(world);player.setGameMode(GameType.SURVIVAL);
+   var pos=new BlockPos(0,100,0); world.setBlock(pos.below(),Blocks.STONE.defaultBlockState(),3);
+   for(String id:new String[]{"omurice","mushroom_pot_pie","roasted_mutton_rack"}) {
+    var block=(FeastBlock)BuiltInRegistries.BLOCK.getValue(Identifier.parse("large_meals:"+id+"_block"));
+    world.setBlock(pos,block.defaultBlockState(),3); check(id+"_four_servings",block.getMaxServings()==4);
+    for(int n=4;n>0;n--) {
+     player.getInventory().clearContent();player.setItemInHand(InteractionHand.MAIN_HAND,new ItemStack(Items.BOWL));
+     var result=block.useItemOn(player.getMainHandItem(),world.getBlockState(pos),world,pos,player,InteractionHand.MAIN_HAND,new BlockHitResult(Vec3.atCenterOf(pos),Direction.UP,pos,false));
+     check(id+"_serve_"+n,result.consumesAction()&&player.getMainHandItem().is(BuiltInRegistries.ITEM.getValue(Identifier.parse("large_meals:"+id)))&&world.getBlockState(pos).getValue(FeastBlock.SERVINGS)==n-1);
+    }
+    check(id+"_leftover",world.getBlockState(pos).is(block));
+   }
+   for(var entry:LMItems.ITEMS.getEntries()) {
+    var stack=new ItemStack(entry.get()); var food=stack.get(DataComponents.FOOD);if(food==null)continue;
+    var consumable=stack.get(DataComponents.CONSUMABLE);check(entry.getId()+"_consumable",consumable!=null);
+    if(food.nutrition()!=5&&food.nutrition()!=10||!entry.getId().getPath().contains("mutton_rack")) {
+     check(entry.getId()+"_effects",consumable.onConsumeEffects().stream().anyMatch(e->e instanceof ApplyStatusEffectsConsumeEffect));
+    }
+    player.getInventory().clearContent();player.removeAllEffects();player.getFoodData().setFoodLevel(1);
+    var result=stack.finishUsingItem(world,player);
+    check(entry.getId()+"_feeds",player.getFoodData().getFoodLevel()==1+food.nutrition());
+    for(var effect:consumable.onConsumeEffects()) if(effect instanceof ApplyStatusEffectsConsumeEffect effects) {
+     for(var expected:effects.effects()) {
+      var actual=player.getEffect(expected.getEffect());
+      check(entry.getId()+"_effect_applied_"+expected.getEffect().unwrapKey().orElseThrow().identifier(),actual!=null&&actual.getDuration()==expected.getDuration()&&actual.getAmplifier()==expected.getAmplifier());
+     }
+    }
+    if(entry.getId().getPath().equals("sweet_berry_custard"))check("custard_bottle",result.is(Items.GLASS_BOTTLE));
+    else if(!entry.getId().getPath().equals("raw_mutton_rack")&&!entry.getId().getPath().equals("cooked_mutton_rack"))check(entry.getId()+"_bowl",result.is(Items.BOWL));
+   }
+   var manager=server.getServerResources().managers().getListener(net.neoforged.neoforge.resource.NeoForgeReloadListeners.LOOT_MODIFIERS_KEY);
+   var sheep=net.minecraft.world.entity.EntityTypes.SHEEP.create(world,net.minecraft.world.entity.EntitySpawnReason.COMMAND);
+   for(boolean burning:new boolean[]{false,true}) {
+    if(burning)sheep.igniteForSeconds(30);else sheep.clearFire();
+    for(boolean knife:new boolean[]{false,true}) {
+     player.setItemInHand(InteractionHand.MAIN_HAND,new ItemStack(knife?vectorwing.farmersdelight.common.registry.ModItems.IRON_KNIFE.get():Items.STICK));
+     var params=new net.minecraft.world.level.storage.loot.LootParams.Builder(world)
+       .withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.THIS_ENTITY,sheep)
+       .withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.DIRECT_ATTACKING_ENTITY,player)
+       .withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.ORIGIN,sheep.position())
+       .withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.DAMAGE_SOURCE,world.damageSources().playerAttack(player))
+       .create(net.minecraft.world.level.storage.loot.parameters.LootContextParamSets.ENTITY);
+     var ctx=new net.minecraft.world.level.storage.loot.LootContext.Builder(params).create(java.util.Optional.empty());
+     for(String kind:new String[]{"raw","cooked"}) {
+      var mod=manager.getModifier(Identifier.parse("large_meals:scavenging_"+kind+"_mutton_rack_from_sheep"));
+      check("loot_modifier_loaded_"+kind,mod!=null);
+      var loot=mod.apply(new it.unimi.dsi.fastutil.objects.ObjectArrayList<ItemStack>(),ctx);
+      check("sheep_loot_"+kind+"_burning_"+burning+"_knife_"+knife,loot.size()==(knife&&(burning==kind.equals("cooked"))?1:0));
+     }
+    }
+   }
+   System.out.println("LM_PROBE COMPLETE");
+  } catch(Throwable ex) {System.out.println("LM_PROBE FAIL");ex.printStackTrace();} finally { server.halt(false); }
+ }
+}
