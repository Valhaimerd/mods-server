+ @SubscribeEvent public static void start(ServerStartedEvent event) {
+ var server=event.getServer();
+ try {
+  var recipes=server.getRecipeManager().getRecipes().stream().filter(r->r.id().identifier().getNamespace().equals("oceansdelight")).toList();
+  check("all31recipes",recipes.size()==31);
+  for(var r:recipes) {
+   var recipe=r.value();
+   var ingredients=recipe instanceof vectorwing.farmersdelight.common.crafting.CookingPotRecipe c ? c.getIngredients() : recipe instanceof vectorwing.farmersdelight.common.crafting.CuttingBoardRecipe c ? c.getIngredients() : recipe.placementInfo().ingredients();
+   check("ingredients_"+r.id().identifier(),!ingredients.isEmpty()&&ingredients.stream().noneMatch(i->i.isEmpty()));
+   var result=((net.minecraft.world.item.crafting.Recipe)recipe).assemble(null);
+   check("result_"+r.id().identifier(),!result.isEmpty()&&BuiltInRegistries.ITEM.getKey(result.getItem()).getNamespace().equals("oceansdelight"));
+   var path="/data/oceansdelight/recipe/"+r.id().identifier().getPath()+".json";
+   try(var input=OceanProbe.class.getResourceAsStream(path)) {
+    var json=com.google.gson.JsonParser.parseReader(new java.io.InputStreamReader(input)).getAsJsonObject();
+    var raw=json.get("result");var first=raw.isJsonArray()?raw.getAsJsonArray().get(0).getAsJsonObject().getAsJsonObject("item"):raw.getAsJsonObject();
+    check("expected_output_"+r.id().identifier(),result.is(BuiltInRegistries.ITEM.getValue(Identifier.parse(first.get("id").getAsString())))&&result.getCount()==first.get("count").getAsInt());
+   }
+   if(recipe instanceof vectorwing.farmersdelight.common.crafting.CookingPotRecipe c) {
+    var slots=new net.neoforged.neoforge.items.ItemStackHandler(6);
+    for(int i=0;i<c.getIngredients().size();i++)slots.setStackInSlot(i,new ItemStack(c.getIngredients().get(i).items().findFirst().orElseThrow()));
+    check("pot_matches_"+r.id().identifier(),c.matches(new net.neoforged.neoforge.items.wrapper.RecipeWrapper(slots),server.overworld()));
+   }
+   if(recipe instanceof vectorwing.farmersdelight.common.crafting.CuttingBoardRecipe c) {
+    var sample=new ItemStack(c.getIngredients().getFirst().items().findFirst().orElseThrow());
+    check("cut_matches_"+r.id().identifier(),c.matches(new vectorwing.farmersdelight.common.crafting.CuttingBoardRecipeInput(sample,new ItemStack(vectorwing.farmersdelight.common.registry.ModItems.IRON_KNIFE.get())),server.overworld()));
+    check("knife_"+r.id().identifier(),c.getTool().test(new ItemStack(vectorwing.farmersdelight.common.registry.ModItems.IRON_KNIFE.get())));
+    check("all_cut_outputs_"+r.id().identifier(),c.getResults().stream().noneMatch(ItemStack::isEmpty));
+   }
+  }
+  check("25items",ODItems.ITEMS.getEntries().size()==25);
+  var world=server.overworld();var player=FakePlayerFactory.getMinecraft(world);player.setGameMode(GameType.SURVIVAL);
+  for(String row:FOODS) {
+   var fields=row.split(",");var id=fields[0];var item=BuiltInRegistries.ITEM.getValue(Identifier.parse("oceansdelight:"+id));var stack=new ItemStack(item);
+   var food=stack.get(DataComponents.FOOD);check(id+"_food",food!=null);
+   check(id+"_nutrition_saturation",food.nutrition()==Integer.parseInt(fields[1])&&Math.abs(food.saturation()-Integer.parseInt(fields[1])*Float.parseFloat(fields[2])*2)<0.0001);
+   check(id+"_alwaysEdible",food.canAlwaysEat()==Boolean.parseBoolean(fields[4]));
+   var consumable=stack.get(DataComponents.CONSUMABLE);check(id+"_duration",Math.abs(consumable.consumeSeconds()-(Boolean.parseBoolean(fields[3])?0.8:1.6))<0.0001);
+   player.getInventory().clearContent();player.removeAllEffects();player.getFoodData().setFoodLevel(1);player.getFoodData().setSaturation(0);
+   var result=stack.finishUsingItem(world,player);
+   check(id+"_eating",player.getFoodData().getFoodLevel()==1+food.nutrition()&&Math.abs(player.getFoodData().getSaturationLevel()-Math.min(1+food.nutrition(),food.saturation()))<0.0001);
+   boolean bowl=java.util.Set.of("squid_rings","bowl_of_guardian_soup","braised_sea_pickle","seagrass_salad").contains(id);
+   check(id+"_remainder",bowl?result.is(Items.BOWL):result.isEmpty());
+   String expectation=switch(id) {
+    case "tentacles","stuffed_squid" -> "minecraft:blindness,600,1.0";
+    case "cooked_stuffed_squid" -> "farmersdelight:comfort,1200,1.0";
+    case "bowl_of_guardian_soup" -> "farmersdelight:comfort,3600,1.0";
+    case "elder_guardian_slice" -> "minecraft:mining_fatigue,3000,0.5";
+    case "cabbage_wrapped_elder_guardian","cooked_stuffed_cod" -> "farmersdelight:comfort,600,1.0";
+    default -> "";
+   };
+   check(id+"_effect_count",consumable.onConsumeEffects().size()==(expectation.isEmpty()?0:1));
+   if(!expectation.isEmpty()) {
+    var expected=expectation.split(",");var effect=(ApplyStatusEffectsConsumeEffect)consumable.onConsumeEffects().getFirst();
+    check(id+"_baseline_effect_component",effect.effects().size()==1&&effect.effects().getFirst().getEffect().unwrapKey().orElseThrow().identifier().toString().equals(expected[0])&&effect.effects().getFirst().getDuration()==Integer.parseInt(expected[1])&&effect.effects().getFirst().getAmplifier()==0&&effect.probability()==Float.parseFloat(expected[2]));
+   }
+   for(var effect:consumable.onConsumeEffects())if(effect instanceof ApplyStatusEffectsConsumeEffect effects) {
+    for(var expected:effects.effects()) {
+     if(effects.probability()==1) {var actual=player.getEffect(expected.getEffect());check(id+"_applied_effect",actual!=null&&actual.getDuration()==expected.getDuration()&&actual.getAmplifier()==0);}
+     else {
+      int applied=0;for(int trial=0;trial<128;trial++){player.removeAllEffects();new ItemStack(item).finishUsingItem(world,player);if(player.hasEffect(expected.getEffect()))applied++;}
+      check(id+"_50percent_component_and_runtime",effects.probability()==0.5F&&applied>0&&applied<128);
+     }
+    }
+   }
+  }
+  check("23foods",FOODS.length==23);
+  var pos=new BlockPos(0,100,0);world.setBlock(pos.below(),Blocks.STONE.defaultBlockState(),3);
+  var block=(FeastBlock)ODBlocks.GUARDIAN_SOUP.get();world.setBlock(pos,block.defaultBlockState(),3);check("soup_four_servings",block.getMaxServings()==4&&world.getBlockState(pos).getValue(FeastBlock.SERVINGS)==4);
+  for(int n=4;n>0;n--) {
+   player.getInventory().clearContent();player.setItemInHand(InteractionHand.MAIN_HAND,new ItemStack(Items.BOWL));
+   var result=block.useItemOn(player.getMainHandItem(),world.getBlockState(pos),world,pos,player,InteractionHand.MAIN_HAND,new BlockHitResult(Vec3.atCenterOf(pos),Direction.UP,pos,false));
+   check("soup_serve_"+n,result.consumesAction()&&player.getMainHandItem().is(ODItems.BOWL_OF_GUARDIAN_SOUP.get())&&world.getBlockState(pos).getValue(FeastBlock.SERVINGS)==n-1);
+  }
+  check("soup_leftover",world.getBlockState(pos).is(block));
+  player.setItemInHand(InteractionHand.MAIN_HAND,ItemStack.EMPTY);
+  block.useItemOn(ItemStack.EMPTY,world.getBlockState(pos),world,pos,player,InteractionHand.MAIN_HAND,new BlockHitResult(Vec3.atCenterOf(pos),Direction.UP,pos,false));
+  check("soup_empty_container_clears",world.getBlockState(pos).isAir());
+  var manager=server.getServerResources().managers().getListener(net.neoforged.neoforge.resource.NeoForgeReloadListeners.LOOT_MODIFIERS_KEY);
+  String[] types={"squid","glow_squid","elder_guardian","guardian","pufferfish"};
+  String[] modifiers={"cut_tentacles_squid","cut_tentacles_glow_squid","cut_elder_guardian","guardian_drop"};
+  String[] drops={"tentacles","tentacles","elder_guardian_slab","guardian"};
+  for(String type:types)for(boolean burning:new boolean[]{false,true})for(boolean knife:new boolean[]{false,true}) {
+   var entity=BuiltInRegistries.ENTITY_TYPE.getValue(Identifier.parse("minecraft:"+type)).create(world,net.minecraft.world.entity.EntitySpawnReason.COMMAND);
+   if(burning)entity.igniteForSeconds(30);else entity.clearFire();player.setItemInHand(InteractionHand.MAIN_HAND,new ItemStack(knife?vectorwing.farmersdelight.common.registry.ModItems.IRON_KNIFE.get():Items.STICK));
+   var params=new net.minecraft.world.level.storage.loot.LootParams.Builder(world).withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.THIS_ENTITY,entity).withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.ATTACKING_ENTITY,player).withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.DIRECT_ATTACKING_ENTITY,player).withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.ORIGIN,entity.position()).withParameter(net.minecraft.world.level.storage.loot.parameters.LootContextParams.DAMAGE_SOURCE,world.damageSources().playerAttack(player)).create(net.minecraft.world.level.storage.loot.parameters.LootContextParamSets.ENTITY);
+   var ctx=new net.minecraft.world.level.storage.loot.LootContext.Builder(params).create(java.util.Optional.empty());
+   for(int i=0;i<4;i++) {
+    var modifier=manager.getModifier(Identifier.parse("farmersdelight:"+modifiers[i]));check("loaded_"+modifiers[i],modifier!=null);
+    var loot=modifier.apply(new it.unimi.dsi.fastutil.objects.ObjectArrayList<ItemStack>(),ctx);boolean should=type.equals(types[i])&&(i==3||knife);
+    check(type+"_fire"+burning+"_knife"+knife+"_"+modifiers[i],loot.size()==(should?1:0)&&(!should||loot.getFirst().is(BuiltInRegistries.ITEM.getValue(Identifier.parse("oceansdelight:"+drops[i])))));
+   }
+  }
